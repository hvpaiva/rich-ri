#!/usr/bin/env bash
cd "$(dirname "$0")/.." || exit 1

bundle install || exit 1

if command -v mise >/dev/null 2>&1; then
  pinned=()
  while IFS= read -r tool; do
    pinned+=("$tool")
  done < <(ruby -r ./rakelib/tools -e 'puts Tools.mise_tools')
  # Without names, mise would install everything mise.toml lists, Ruby included.
  if [ "${#pinned[@]}" -gt 0 ]; then
    mise install "${pinned[@]}" || printf 'setup: mise install failed; the lines below name what is still missing.\n' >&2
  fi
fi

status=0
ruby -r ./rakelib/tools -e 'exit Tools.report.empty?' || status=1
ruby -r ./rakelib/shell_tests -e '
  begin
    ShellTests.verify_environment!
  rescue ShellTests::Error => e
    abort "setup: #{e.message}"
  end
' || status=1
printf 'Run bundle exec rake for tests and Ruby lint, bundle exec rake check for the CI quality checks\n'
printf 'and bundle exec rake test:compatibility for the oldest supported dependencies.\n'
exit "$status"

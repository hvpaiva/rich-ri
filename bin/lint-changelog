#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../rakelib/changelog"

# Usage: bin/lint-changelog [BASE]. SKIP_CHANGELOG=1 waives the entry that BASE requires.
begin
  base = ARGV.first unless %w[1 true].include?(ENV.fetch("SKIP_CHANGELOG", nil))
  problems = Changelog.lint(root: Dir.pwd, base: base)
  abort problems.map { |problem| "#{Changelog::PATH}: #{problem}" }.join("\n") unless problems.empty?
rescue Changelog::Error => e
  abort "lint-changelog: #{e.message}"
end

#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../rakelib/changelog_lint"

parser = OptionParser.new do |opts|
  opts.banner = "Usage: ruby bin/lint-changelog [BASE]"
  opts.separator ""
  opts.separator "Checks the structure of CHANGELOG.md in the current directory."
  opts.separator ""
  opts.separator "BASE is a revision such as origin/main. When it is given, a branch that changes"
  opts.separator "#{Changelog::Lint::USER_VISIBLE_NAMES} needs a new entry under"
  opts.separator '"## [Unreleased]". SKIP_CHANGELOG=1 or SKIP_CHANGELOG=true waives that entry;'
  opts.separator "the structure is still checked."
end

begin
  arguments = parser.parse(ARGV)
  raise OptionParser::NeedlessArgument, arguments.drop(1).join(" ") if arguments.length > 1

  base = arguments.first
  if base && !system("git", "rev-parse", "--verify", "--quiet", "--end-of-options", "#{base}^{commit}",
                     out: File::NULL, err: File::NULL)
    raise OptionParser::InvalidArgument, "#{base} (use a revision such as origin/main)"
  end

  base = nil if %w[1 true].include?(ENV.fetch("SKIP_CHANGELOG", nil))
  problems = Changelog::Lint.problems(root: Dir.pwd, base: base)
  abort problems.map { |problem| "lint-changelog: #{Changelog::PATH}: #{problem}" }.join("\n") unless problems.empty?
rescue OptionParser::ParseError => e
  warn "lint-changelog: #{Untrusted.visible(e.message)}\n#{parser}"
  exit 2
rescue Changelog::Lint::Error => e
  abort "lint-changelog: #{Untrusted.visible(e.message)}"
end

#!/usr/bin/env ruby
# frozen_string_literal: true

root = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(root, "lib"), File.join(root, "test"))
maintenance = /\A(?:release.*|ci.*|github|commit_policy|project|test_environment|shell_runner)_test\.rb\z/
Dir[File.join(root, "test/*_test.rb")].each do |path|
  next if File.basename(path).match?(maintenance)

  require path
end

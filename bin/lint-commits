#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../rakelib/commits"

begin
  errors = CommitPolicy.problems(ARGV.fetch(0, "HEAD"), title: ENV.fetch("PR_TITLE", nil),
                                                        body: ENV.fetch("PR_BODY", nil))
  abort errors.join("\n") unless errors.empty?
rescue ArgumentError => e
  abort e.message
end

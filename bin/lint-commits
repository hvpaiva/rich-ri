#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

range = ARGV.fetch(0, "HEAD")
messages, status = Open3.capture2("git", "log", "--no-merges", "--format=%B%x00", range)
abort "Cannot read commit range" unless status.success?
messages = messages.split("\0").map(&:strip)
messages << ENV["PR_TITLE"] if ENV["PR_TITLE"]
pattern = /\A(?:feat|fix|docs|test|refactor|perf|build|ci|chore|revert)(?:\([\w.-]+\))?!?: \S/
messages.each do |message|
  abort "Use a Conventional Commit subject: #{message.lines.first}" unless message.lines.first&.match?(pattern)
  abort "Remove attribution trailers" if message.match?(/^Co-authored-by:|^Generated-by:/i)
end

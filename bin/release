#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../rakelib/release_workflow"

options = { push: false, dry_run: false }
parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/release X.Y.Z [--push | --dry-run]"
  opts.on("--push", "Prepare or resume, wait for checks, merge and publish through GitHub Actions") do
    options[:push] = true
  end
  opts.on("--dry-run", "Validate and preview the changelog without writing files or publishing") do
    options[:dry_run] = true
  end
end

begin
  parser.parse!(ARGV)
  raise OptionParser::InvalidArgument, "exactly one version is required" unless ARGV.length == 1
  raise OptionParser::InvalidArgument, "--push and --dry-run cannot be combined" if options.values.all?

  Release::Workflow.new(ARGV.first, **options).run
rescue OptionParser::ParseError => e
  warn "release: #{e.message}\n#{parser}"
  exit 2
rescue StandardError => e
  abort "release: #{e.message}"
end
